]
EXTRA = {"pinned": False, "muted": False, "mentions": 0}
FOLDERS = [
    {"id": 2, "title": "Work", "kind": "folder", "chats": [1002, 1001, 1004]},
    {"id": 3, "title": "Bots", "kind": "folder", "chats": [1001, 1007]},
    {"id": 0, "title": "All chats", "kind": "all", "chats": [d["id"] for d in DIALOGS]},
