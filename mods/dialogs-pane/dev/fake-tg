def msg(i, text, sender, chat, out=False, date="2026-10-10T21:00:00Z", buttons=(), reply_to=None):
    return {"id": i, "chat_id": chat, "date": date, "sender": sender, "out": out, "text": text,
            "reply_to": reply_to, "forward": None, "edited": None, "edits": 0, "pinned": False,
            "service": None, "via_bot": None, "media": None, "keyboard": "inline" if buttons else None,
            "buttons": list(buttons), "reactions": [], "links": []}


