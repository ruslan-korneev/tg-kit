def rows():
    """Every chat's row, the chats a watch event wrote to newest first, as Telegram would list them."""
    seen = {}
    spool = os.path.join(STATE, "watch.jsonl")
    if os.path.exists(spool):
        for line in open(spool):
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if event.get("event") == "message" and "chat_id" in event:
                seen[event["chat_id"]] = event
    out = []
    for d in DIALOGS + MANY:
        row = {**d, **EXTRA, **ROW_EXTRA.get(d["id"], {})}
        event = seen.get(d["id"])
        if event is not None and event["id"] > (row["last_id"] or 0):
            row.update(last_id=event["id"], last_date=event["date"], last_text=event.get("text", ""),
                       unread=0 if event.get("out") else row["unread"] + 1)
        out.append(row)
    return out


def ordered(ids, by_id):
    return sorted((i for i in ids if i in by_id), key=lambda i: by_id[i]["last_date"] or "", reverse=True)


def peer_id(arg):
    if arg == "me":
        return 1003
    for d in DIALOGS + MANY:
        if arg.lstrip("@").lower() == (d["username"] or "").lower() or arg == str(d["id"]):
            return d["id"]
    return None


def out(value, code=0):
    print(json.dumps(value))
    sys.exit(code)


def fail(text, code):
    print(f"error: {text}", file=sys.stderr)
    sys.exit(code)


def guard(argv, pid):
    """tg's guard, as far as the pane meets it: allow.toml unless --yes.

    tg has no BotFather rule: the pane refuses BotFather before tg runs. A write
    that gets here is a pane bug, so the fake fails loudly instead of covering it.
    """
    if pid == 1007:
        loud = "fake tg: a write reached BotFather; the pane must refuse it before tg runs"
        with open(os.path.join(STATE, "calls.log"), "a") as log:
            log.write(f"!! {loud}\n")
        fail(loud, 1)
    if pid not in ALLOW and "--yes" not in argv:
        return {"allowed": False, "reason": "target is not in the allowlist"}
    return {"allowed": True, "reason": "allowlisted" if pid in ALLOW else "confirmed with --yes"}


def flag(argv, name, default=None):
    return argv[argv.index(name) + 1] if name in argv else default


def main(argv):
    with open(os.path.join(STATE, "calls.log"), "a") as log:
        log.write(" ".join(argv) + "\n")
    cmd = argv[0] if argv else ""
    if cmd == "whoami":
        out(ME)
    if cmd == "allow":
        out([{"id": i} for i in ALLOW])
    if cmd == "dialogs":
        by_id = {r["id"]: r for r in rows()}
        listed = [by_id[i] for i in ordered([d["id"] for d in DIALOGS], by_id)]
        folder = flag(argv, "--folder")
        query = flag(argv, "--query")
        if "--archived" in argv:
            listed = []
        if folder is not None:
            match = [f for f in FOLDERS if str(f["id"]) == folder or f["title"] == folder]
            if not match:
                fail(f"no folder {folder}\n  fix: tg folders", 4)
            listed = [by_id[i] for i in ordered(match[0]["chats"], by_id)]
        if query is not None:
            listed = [r for r in by_id.values() if query.lower() in f"{r['title']} {r['username'] or ''}".lower()]
        out(listed[: int(flag(argv, "--limit", "50"))])
    if cmd == "folders":
        by_id = {r["id"]: r for r in rows()}
        unread = lambda f: sum(1 for i in f["chats"] if by_id[i]["unread"] > 0 and not by_id[i]["muted"])
        listed = [{"id": f["id"], "title": f["title"], "kind": f["kind"]} for f in FOLDERS]
        if "--chats" in argv:
            flood = os.path.join(STATE, "flood")
            if os.path.exists(flood):
                seconds = open(flood).read().strip() or "40"
                os.remove(flood)
                fail(f"FLOOD_WAIT {seconds}s: Telegram asks to wait before retrying", 5)
            members = {i for f in FOLDERS for i in f["chats"]}
            out({"at": "2026-10-10T21:05:00+00:00", "scan": 500,
                 "folders": [{**l, "unread": unread(f), "pinned": [], "chats": ordered(f["chats"], by_id)} for l, f in zip(listed, FOLDERS)],
                 "dialogs": [r for r in by_id.values() if r["id"] in members]})
        if "--counts" in argv:
            out([{**l, "unread": unread(f)} for l, f in zip(listed, FOLDERS)])
        out(listed)
    pid = peer_id(argv[1]) if len(argv) > 1 else None
    if cmd in ("read", "msg", "send", "press", "delete", "watch") and pid is None:
        fail(f"no chat {argv[1] if len(argv) > 1 else ''}\n  fix: tg dialogs", 4)
    if cmd == "read":
        thread = THREADS.get(pid) or [msg(100, "placeholder note", CONTACT_A, pid, False, "2026-10-10T18:00:00Z")]
        out(thread[-int(flag(argv, "--limit", "30")):])
    if cmd == "msg":
        wanted = {int(a) for a in argv[2:] if a.isdigit()}
        found = [m for m in THREADS.get(pid, []) if m["id"] in wanted]
        if not found:
            fail("message not found", 4)
        out(found)
    if cmd == "send":
        verdict = guard(argv, pid)
        if "--dry-run" in argv:
            out({"action": "send", "target": {"id": pid}, "steps": [], "guard": verdict})
        if not verdict["allowed"]:
            fail(f"{verdict['reason']}; rerun with --yes only if the owner agreed\n  fix: tg allow add", 7)
        text = sys.stdin.read()
        sent = msg(int(time.time()) % 100000 + 700000, text, ME, pid, True)
        replies = [msg(sent["id"] + 1, f"got: {text}", BOT, pid)] if pid == 1001 and "--wait" in argv else []
        out({"sent": [sent], "replies": replies})
    if cmd == "press":
        verdict = guard(argv, pid)
        if not verdict["allowed"]:
            fail(f"{verdict['reason']}\n  fix: tg allow add", 7)
        target = int(argv[2])
        edited = msg(target, "Settings saved", BOT, pid, buttons=[[RETRY[0][1]]])
        out({"button": BUTTONS[0][0], "answer": {"alert": None, "toast": "Saved", "url": None}, "replies": [edited]})
    if cmd == "delete":
        out({"deleted": [int(a) for a in argv[2:] if a.isdigit()]})
    if cmd == "watch":
        spool = os.path.join(STATE, "watch.jsonl")
        open(spool, "a").close()
        print(json.dumps({"event": "ready", "date": "2026-10-10T21:05:00Z", "peers": [pid]}), flush=True)
        with open(spool) as lines:
            lines.seek(0, os.SEEK_END)
            while True:
                line = lines.readline()
                if line:
                    event = json.loads(line)
                    if event.get("chat_id", pid) == pid:
                        print(line.strip(), flush=True)
                else:
                    time.sleep(0.2)
    fail(f"fake tg does not answer: {' '.join(argv)}", 1)


if __name__ == "__main__":
    main(sys.argv[1:])
