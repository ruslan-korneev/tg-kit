    {"id": 1007, "kind": "bot", "title": "BotFather", "username": "BotFather", "unread": 0,
     "last_id": 3, "last_date": "2026-10-08T10:00:00Z", "last_text": "Done! Congratulations"},
    {"id": 1006, "kind": "channel", "title": "Announcements", "username": None, "unread": 14,
     "last_id": 7, "last_date": "2026-10-10T19:19:00Z", "last_text": "release 2.0 is out"},
